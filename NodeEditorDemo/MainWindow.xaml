<Window
    x:Class="NodeEditorDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:NodeEditor.Controls;assembly=NodeEditor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:local="clr-namespace:NodeEditorDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NodeEditorDemo.ViewModels"
    Title="MainWindow"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance vm:MainViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>
        <c:WidgetControl Grid.RowSpan="2" Nodes="{Binding Containers}" />
        <Border
            Grid.Column="2"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="Transparent">
            <StackPanel Orientation="Horizontal">
                <Button
                    Margin="10"
                    Padding="20,5,20,5"
                    Background="{DynamicResource PrimaryBrush}"
                    Command="{Binding AddDataCommand}"
                    Content="Add Node"
                    Foreground="White" />
                <Button
                    Margin="10"
                    Padding="20,5,20,5"
                    Background="{DynamicResource PrimaryBrush}"
                    Command="{Binding RunDemoCommand}"
                    Content="Run Demo"
                    Foreground="White" />
            </StackPanel>
        </Border>
        <c:NodeEditorControlContainer
            Grid.Row="1"
            Grid.Column="2"
            Arrows="{Binding Arrows}"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            DangerBrush="{DynamicResource DangerBrush}"
            DefaultCornerRadius="{StaticResource DefaultCornerRadius}"
            Nodes="{Binding Nodes}"
            RegionBrush="{DynamicResource RegionBrush}"
            SecondaryRegionBrush="{DynamicResource SecondaryRegionBrush}"
            SuccessBrush="{DynamicResource SuccessBrush}"
            TextBrush="{DynamicResource TextBrush}" />
    </Grid>
</Window>
