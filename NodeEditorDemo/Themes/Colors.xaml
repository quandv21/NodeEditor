<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#1e1e1e</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="RegionColor">#424242</Color>
    <Color x:Key="SecondaryRegionColor">#2a2a2a</Color>
    <Color x:Key="BorderColor">#3a3a3a</Color>
    <Color x:Key="PrimaryColor">#007bff</Color>
    <Color x:Key="SecondaryColor">#6c757d</Color>
    <Color x:Key="SuccessColor">#28a745</Color>
    <Color x:Key="DangerColor">#dc3545</Color>
    <Color x:Key="WarningColor">#ffc107</Color>
    <Color x:Key="AlertPrimaryColor">#cce5ff</Color>
    <Color x:Key="AlertSuccessColor">#d4edda</Color>
    <Color x:Key="AlertDangerColor">#f8d7da</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource RegionColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource SecondaryRegionColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="AlertPrimaryBrush" Color="{StaticResource AlertPrimaryColor}" />
    <SolidColorBrush x:Key="AlertSuccessBrush" Color="{StaticResource AlertSuccessColor}" />
    <SolidColorBrush x:Key="AlertDangerBrush" Color="{StaticResource AlertDangerColor}" />

</ResourceDictionary>