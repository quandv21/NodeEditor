                            Margin="0,0,0,-20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            ConnectionPoint="{Binding Setting.CB, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}"
                            EditorView="{Binding EditorView, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}"
                            IsHitTestVisible="True"
                            IsSelected="{Binding Setting.CB.IsSelected, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}">
                            <c:ConnectionPointControl.Visibility>
                                <MultiBinding Converter="{StaticResource MultiBoolToVisibilityConverter}">
                                    <Binding Path="Setting.IsSelected" RelativeSource="{RelativeSource AncestorType={x:Type c:NodeControl}}" />
                                    <Binding Path="Setting.IsMouseOver" RelativeSource="{RelativeSource AncestorType={x:Type c:NodeControl}}" />
                                    <Binding Path="ConnectionPoint.IsConnected" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </c:ConnectionPointControl.Visibility>
                        </c:ConnectionPointControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>