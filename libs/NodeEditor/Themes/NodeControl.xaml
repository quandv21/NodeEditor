                        <Rectangle
                            x:Name="DashBorder"
                            Width="{Binding Setting.Width, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}"
                            Height="{Binding Setting.Height, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}"
                            Panel.ZIndex="1"
                            Fill="Transparent"
                            RadiusX="8"
                            RadiusY="8"
                            Stroke="{Binding SuccessBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}"
                            StrokeDashArray="8 4"
                            StrokeThickness="2"
                            Visibility="{Binding Setting.IsRunning, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="DashBorder"
                                                Storyboard.TargetProperty="StrokeDashOffset"
                                                From="0"
                                                To="-12"
                                                Duration="0:0:0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                        <Border
                            x:Name="Part_MainBorder"
                            Width="{Binding Setting.Width, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}"
                            Height="{Binding Setting.Height, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}"
                            BorderThickness="2"
                            CornerRadius="{Binding DefaultCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}"
                            Cursor="Hand"
                            ToolTipService.BetweenShowDelay="10"
                            ToolTipService.InitialShowDelay="200">
                            <Border.ToolTip>
                                <ToolTip Background="Transparent" BorderThickness="0">
                                    <ToolTip.ContentTemplate>
                                        <DataTemplate>
                                            <Border
                                                MinWidth="150"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}"
                                                BorderThickness="2"
                                                CornerRadius="{Binding DefaultCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect
                                                                    BlurRadius="8"
                                                                    Opacity="0.8"
                                                                    ShadowDepth="0"
                                                                    Color="{DynamicResource BorderColor}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TemplatedParent.Setting.Result, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="False">
                                                                <Setter Property="BorderBrush" Value="{Binding DangerBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TemplatedParent.Setting.Result, RelativeSource={RelativeSource AncestorType=ToolTip}}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{Binding SuccessBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    Margin="10,5"
                                                    FontSize="11"
                                                    Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}"
                                                    Text="{Binding TemplatedParent.Setting.ToolTip, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                            </Border>
                                        </DataTemplate>
                                    </ToolTip.ContentTemplate>
                                </ToolTip>
                            </Border.ToolTip>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}" />
                                    <Setter Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Setting.IsSelected, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding PrimaryBush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                            <Setter Property="BorderThickness" Value="3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Setting.IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}" Value="False">
                                            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}, Converter={StaticResource BackgroundToDisabledConverter}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Setting.Result, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}" Value="OK">
                                            <Setter Property="BorderBrush" Value="{Binding SuccessBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Setting.Result, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}" Value="NG">
                                            <Setter Property="BorderBrush" Value="{Binding DangerBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{Binding RegionBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" CornerRadius="4,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="10,5"
                                            HorizontalAlignment="Left"
                                            FontSize="13"
                                            Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}"
                                            Text="{Binding Setting.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,5"
                                            HorizontalAlignment="Right"
                                            FontSize="13"
                                            Foreground="{Binding SuccessBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}">
                                            <Run Text="{Binding Setting.Duration, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <Run Text="ms" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3.3*" />
                                        <RowDefinition Height="3.35*" />
                                        <RowDefinition Height="3.35*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="10,0"
                                        HorizontalAlignment="Left"
                                        Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}">
                                        <Run Text="X: " />
                                        <Run Text="{Binding Setting.X, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}" />
                                    </TextBlock>
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="10,0"
                                        HorizontalAlignment="Left"
                                        Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}">
                                        <Run Text="Y: " />
                                        <Run Text="{Binding Setting.Y, RelativeSource={RelativeSource AncestorType={x:Type c:NodeControl}}}" />
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                        <c:ConnectionPointControl
                            Margin="-20,0,0,0"
