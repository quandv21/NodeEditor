<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:NodeEditor.Controls">
    <Style TargetType="{x:Type c:ConnectionPointControl}">
        <Setter Property="Panel.ZIndex" Value="99999" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ConnectionPointControl}">
                    <Border
                        Width="{Binding ConnectionPoint.Size, RelativeSource={RelativeSource AncestorType={x:Type c:ConnectionPointControl}}}"
                        Height="{Binding ConnectionPoint.Size, RelativeSource={RelativeSource AncestorType={x:Type c:ConnectionPointControl}}}"
                        BorderBrush="Transparent"
                        CornerRadius="10000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding SuccessBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{Binding PrimaryBush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                    </Trigger>

                                    <DataTrigger Binding="{Binding ConnectionPoint.IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type c:ConnectionPointControl}}}" Value="True">
                                        <Setter Property="Background" Value="{Binding PrimaryBush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionPoint.IsSelected, RelativeSource={RelativeSource AncestorType={x:Type c:ConnectionPointControl}}}" Value="True">
                                        <Setter Property="Background" Value="{Binding PrimaryBush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>