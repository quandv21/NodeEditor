<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:NodeEditor.Controls"
    xmlns:models="clr-namespace:NodeEditor.Models">

    <Style TargetType="{x:Type c:WidgetControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:WidgetControl}">
                    <Grid>
                        <Grid.Resources>
                            <CollectionViewSource x:Key="GroupedItems" Source="{Binding Nodes, RelativeSource={RelativeSource AncestorType={x:Type c:WidgetControl}}}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Group" />
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </Grid.Resources>
                        <ListBox
                            x:Name="PART_ListBox"
                            Background="Transparent"
                            ItemsSource="{Binding Source={StaticResource GroupedItems}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="20,4,4,4" Text="{Binding Title}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <Expander
                                                            Margin="5"
                                                            Padding="2"
                                                            Background="Transparent"
                                                            BorderBrush="#CCC"
                                                            Header="{Binding Name}"
                                                            IsExpanded="True">
                                                            <ItemsPresenter />
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>