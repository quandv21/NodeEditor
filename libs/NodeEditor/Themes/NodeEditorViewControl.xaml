<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:NodeEditor.Controls"
    xmlns:dd="urn:gong-wpf-dragdrop">
    <Style TargetType="{x:Type c:NodeEditorViewControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:NodeEditorViewControl}">
                    <Canvas
                        x:Name="PART_Canvas"
                        Width="20000"
                        Height="20000"
                        AllowDrop="True"
                        ClipToBounds="True">
                        <Canvas.Background>
                            <DrawingBrush
                                TileMode="Tile"
                                Viewport="0,0,20,20"
                                ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                                                <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" Thickness="0.2" />
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Canvas.Background>
                        <ItemsControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ItemsSource="{Binding Nodes, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorViewControl}}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left" Value="{Binding X, Mode=OneWay}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y, Mode=OneWay}" />
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex, Mode=TwoWay}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:NodeControl
                                        Background="{Binding SecondaryRegionBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}"
                                        EditorView="{Binding RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorViewControl}}}"
                                        Foreground="{Binding TextBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}"
                                        Setting="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Connections, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorViewControl}}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:ConnectionLineControl
                                        Connection="{Binding}"
                                        EditorView="{Binding RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorViewControl}}}"
                                        EndX="{Binding ToPoint.X, Mode=OneWay}"
                                        EndY="{Binding ToPoint.Y, Mode=OneWay}"
                                        IsSelected="{Binding IsSelected, Mode=TwoWay}"
                                        StartX="{Binding FromPoint.X, Mode=OneWay}"
                                        StartY="{Binding FromPoint.Y, Mode=OneWay}">
                                        <c:ConnectionLineControl.Style>
                                            <Style TargetType="c:ConnectionLineControl">
                                                <Setter Property="Background" Value="{Binding SuccessBrush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{Binding PrimaryBush, RelativeSource={RelativeSource AncestorType={x:Type c:NodeEditorControlContainer}}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </c:ConnectionLineControl.Style>
                                    </c:ConnectionLineControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>