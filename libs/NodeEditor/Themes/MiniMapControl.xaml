<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:NodeEditor.Controls">
    <Style TargetType="{x:Type cc:MiniMapControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type cc:MiniMapControl}">

                    <Grid Margin="30">
                        <Border
                            x:Name="PART_Container"
                            Width="300"
                            Height="150"
                            Background="{Binding SecondaryRegionBrush, RelativeSource={RelativeSource AncestorType={x:Type cc:NodeEditorControlContainer}}}"
                            BorderBrush="{Binding PrimaryBush, RelativeSource={RelativeSource AncestorType={x:Type cc:NodeEditorControlContainer}}}"
                            BorderThickness="1"
                            IsHitTestVisible="True"
                            Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type cc:MiniMapControl}}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Canvas x:Name="PART_View">
                                <Canvas.Background>
                                    <VisualBrush
                                        AlignmentX="Center"
                                        AlignmentY="Center"
                                        Stretch="Uniform"
                                        Viewbox="0,0,3000,1500"
                                        ViewboxUnits="Absolute"
                                        Visual="{Binding ScrollViewer.Content, RelativeSource={RelativeSource AncestorType={x:Type cc:MiniMapControl}}}" />
                                </Canvas.Background>
                                <Thumb
                                    x:Name="PART_BoxView"
                                    Width="45"
                                    Height="45"
                                    Cursor="Hand">
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Rectangle Fill="Transparent" Stroke="{Binding DangerBrush, RelativeSource={RelativeSource AncestorType={x:Type cc:NodeEditorControlContainer}}}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>
                            </Canvas>
                        </Border>
                        <Button
                            x:Name="PART_ToggleMiniMap"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="PART_BackgroundIcon"
                                                    Padding="10"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    IsHitTestVisible="True">
                                                    <Path
                                                        x:Name="PART_ToggleIcon"
                                                        Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Center"
                                                        Data="M16.5 11a.5.5 0 0 1 0 1h-3.793l5.147 5.147a.5.5 0 0 1-.707.707L12 12.707V16.5a.5.5 0 1 1-1 0v-5a.5.5 0 0 1 .5-.5zM2.146 2.147a.5.5 0 0 1 .707 0L8 7.293V3.5a.5.5 0 1 1 1 0v5a.5.5 0 0 1-.5.5h-5a.5.5 0 0 1 0-1h3.793L2.146 2.854a.5.5 0 0 1 0-.707"
                                                        Fill="#FFF"
                                                        Stretch="Uniform"
                                                        Stroke="Transparent" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type cc:MiniMapControl}}}" Value="False">
                                                        <Setter TargetName="PART_ToggleIcon" Property="Data" Value="M10.5 4a.5.5 0 0 1 0 1H5.707L15 14.293V9.5a.5.5 0 0 1 1 0v6a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1 0-1h4.793L5 5.707V10.5a.5.5 0 0 1-1 0v-6a.5.5 0 0 1 .5-.5z" />
                                                        <Setter TargetName="PART_BackgroundIcon" Property="Background" Value="{Binding SecondaryRegionBrush, RelativeSource={RelativeSource AncestorType={x:Type cc:NodeEditorControlContainer}}}" />
                                                        <Setter TargetName="PART_BackgroundIcon" Property="BorderBrush" Value="{Binding PrimaryBush, RelativeSource={RelativeSource AncestorType={x:Type cc:NodeEditorControlContainer}}}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>